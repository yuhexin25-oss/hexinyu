---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import { getBlogPostHref, getBlogPostImage, getPublishedBlogPosts } from '../data/blogPosts';

const base = import.meta.env.BASE_URL;
const readingNotes = await getCollection('reading-notes');
const noteSortValue = (note: (typeof readingNotes)[number]) => {
  const dateAdded = note.data.dateAdded ? new Date(note.data.dateAdded).getTime() : Number.NaN;
  if (!Number.isNaN(dateAdded)) return dateAdded;
  const year = Number(note.data.year ?? note.data.sourceDate ?? 0);
  return Number.isFinite(year) ? year : 0;
};
const latestReadingNote = readingNotes
  .slice()
  .sort((a, b) => {
    const dateDifference = noteSortValue(b) - noteSortValue(a);
    if (dateDifference !== 0) return dateDifference;
    return Number(b.data.year ?? b.data.sourceDate ?? 0) - Number(a.data.year ?? a.data.sourceDate ?? 0);
  })[0];
const latestReadingNoteHref = latestReadingNote
  ? `${base}reading-notes/${latestReadingNote.data.source.slug}/${latestReadingNote.data.noteSlug}/`
  : `${base}reading-notes/`;
const featuredProjects = [
  {
    title: 'U.S. Airline Hub Atlas',
    type: 'Interactive Map',
    description: 'Interactive visualization of U.S. airline hub structures and connectivity patterns.',
    tags: ['MapLibre', 'D3', 'FAA/BTS'],
    href: 'https://yuhexin25.github.io/us-airline-hub-atlas/',
    image: `${base}project-previews/hub-atlas-real.png`,
    imageAlt: 'Screenshot of the U.S. Airline Hub Atlas showing routes, hub airports, and network metrics.',
    external: true,
  },
  {
    title: 'Live Flight Delay Analysis',
    type: 'Live Dashboard',
    description: 'Real-time aviation delay monitoring and route risk assessment using FAA and aviation data.',
    tags: ['Dashboard', 'FAA Data', 'Risk Scoring'],
    href: 'https://yuhexin25.github.io/livedelayanalysis/',
    image: `${base}project-previews/live-delay-page.png`,
    imageAlt: 'Screenshot of the Live Flight Delay Analysis project page showing the Hub Resilience Monitor.',
    external: true,
  },
];
const latestBlogPost = getPublishedBlogPosts()[0];
const featuredWriting = latestBlogPost ? [{
  title: latestBlogPost.title,
  type: 'Latest Blog / Research Writing',
  description: latestBlogPost.description,
  tags: [latestBlogPost.category, 'Ultra-Long-Haul', 'Airline Networks'],
  href: getBlogPostHref(latestBlogPost, base),
  image: getBlogPostImage(latestBlogPost, base),
  imageAlt: latestBlogPost.imageAlt,
  external: false,
}] : [];
---

<Layout
  title="Aviation Analytics Portfolio"
  description="Hexin Yu is a Virginia Tech Computational Modeling & Data Analytics student interested in aviation analytics, transportation systems, data visualization, and network analysis."
>
  <section class="hero-section" aria-labelledby="home-title">
    <div class="container priority-grid">
      <div class="hero-copy">
        <h1 id="home-title">Hexin Yu</h1>
        <p class="hero-subtitle">Computational Modeling &amp; Data Analytics<br />Virginia Tech</p>
        <p class="lead">
          Building interactive tools for aviation networks and transportation systems.
        </p>
        <div class="button-row">
          <a class="button" href={`${base}projects`}>View Projects</a>
        </div>
      </div>
      <section class="featured-projects" aria-labelledby="featured-projects-heading">
        <div class="featured-projects-heading">
          <h2 id="featured-projects-heading">Selected Projects</h2>
        </div>
        <div class="featured-project-list">
          {featuredProjects.map((project) => (
            <a
              class="priority-project-card"
              href={project.href}
              target={project.external ? '_blank' : undefined}
              rel={project.external ? 'noopener noreferrer' : undefined}
              aria-label={`View ${project.title}`}
            >
              <img src={project.image} alt={project.imageAlt} />
              <div class="priority-project-copy">
                <div class="project-eyebrow"><b>{project.type}</b></div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="priority-tag-list" aria-label={`${project.title} methods and data`}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </a>
          ))}
        </div>
        <div class="featured-projects-heading writing-heading">
          <h2>Selected Writing</h2>
        </div>
        <div class="featured-project-list">
          {featuredWriting.map((project) => (
            <a
              class="priority-project-card"
              href={project.href}
              target={project.external ? '_blank' : undefined}
              rel={project.external ? 'noopener noreferrer' : undefined}
              aria-label={`Read ${project.title}`}
            >
              <img src={project.image} alt={project.imageAlt} />
              <div class="priority-project-copy">
                <div class="project-eyebrow"><b>{project.type}</b></div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="priority-tag-list" aria-label={`${project.title} topics`}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>

  {latestReadingNote && (
    <section class="latest-reading-section" aria-labelledby="latest-reading-heading">
      <div class="container latest-reading-grid">
        <div class="latest-reading-copy">
          <p class="page-kicker">Latest Reading Note</p>
          <h2 id="latest-reading-heading">{latestReadingNote.data.title}</h2>
          <p>{latestReadingNote.data.description}</p>
        </div>
        <a class="latest-reading-card" href={latestReadingNoteHref}>
          <div>
            <span>{latestReadingNote.data.source.category}</span>
            <strong>{latestReadingNote.data.source.name}</strong>
          </div>
          {latestReadingNote.data.authors && <p>{latestReadingNote.data.authors}</p>}
          <ul class="priority-tag-list" aria-label={`${latestReadingNote.data.title} topics`}>
            {(latestReadingNote.data.topics ?? [latestReadingNote.data.topic]).slice(0, 4).map((topic) => <li>{topic}</li>)}
          </ul>
          <small>{latestReadingNote.data.year ?? latestReadingNote.data.sourceDate}{latestReadingNote.data.readingTime ? ` · ${latestReadingNote.data.readingTime}` : ''}</small>
        </a>
      </div>
    </section>
  )}
</Layout>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(231, 229, 228, 0.82);
    background:
      linear-gradient(135deg, #fffdf8 0%, #fff8ed 50%, #fffdf8 100%);
    padding: 44px 0 46px;
  }

  .priority-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(42px, 6vw, 82px);
    align-items: center;
  }

  .hero-copy {
    max-width: 580px;
  }

  .hero-copy .page-kicker {
    color: var(--gold-dark);
  }

  .hero-copy h1 {
    margin-top: 4px;
    color: var(--text);
    font-size: clamp(3rem, 5.2vw, 4.8rem);
  }

  .hero-copy .lead {
    max-width: 440px;
    margin-top: 16px;
    color: #475569;
    font-size: 1rem;
    line-height: 1.6;
  }

  .hero-subtitle {
    margin-top: 8px;
    color: var(--accent-dark);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: 760;
    line-height: 1.45;
  }

  .hero-copy .button-row {
    margin-top: 22px;
  }

  .hero-copy .button {
    min-height: 42px;
    border-color: var(--border-strong);
    background: #fff;
    color: var(--text);
    padding-inline: 18px;
    font-size: 0.92rem;
    font-weight: 680;
  }

  .hero-copy .button:first-child {
    border-color: rgba(180, 83, 9, 0.34);
    background: #b45309;
    color: #fffdf8;
  }

  .hero-copy .button:hover {
    border-color: rgba(180, 83, 9, 0.48);
    background: #92400e;
    color: #fff;
  }

  .featured-projects {
    min-width: 0;
    padding-left: clamp(26px, 4vw, 48px);
  }

  .featured-projects-heading {
    margin-bottom: 16px;
  }

  .writing-heading {
    margin-top: 24px;
  }

  .featured-projects-heading h2 {
    font-size: clamp(1.55rem, 2.4vw, 2.1rem);
  }

  .featured-project-list {
    display: grid;
    gap: 12px;
  }

  .priority-project-card {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    overflow: hidden;
    min-height: 146px;
    border: 1px solid rgba(214, 200, 181, 0.78);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 8px 22px rgba(63, 47, 31, 0.045);
    color: var(--text);
    cursor: pointer;
    padding: 11px 14px 11px 11px;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .priority-project-card:hover {
    border-color: rgba(180, 83, 9, 0.34);
    background: #fff;
    box-shadow: 0 14px 30px rgba(63, 47, 31, 0.075);
    color: var(--text);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .priority-project-card:focus-visible {
    outline: 3px solid rgba(37, 99, 235, 0.28);
    outline-offset: 3px;
    border-color: rgba(180, 83, 9, 0.44);
  }

  .priority-project-card img {
    width: 136px;
    height: 124px;
    border-radius: 12px;
    object-fit: cover;
  }

  .priority-project-copy {
    min-width: 0;
  }

  .project-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 9px;
    align-items: center;
  }

  .project-eyebrow b {
    color: #64748b;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .priority-project-card h3 {
    margin-top: 3px;
    font-size: clamp(1.02rem, 1.5vw, 1.22rem);
  }

  .priority-project-copy > p {
    max-width: 560px;
    margin-top: 5px;
    color: #5f6b7a;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .priority-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .priority-tag-list li {
    border: 1px solid rgba(214, 211, 209, 0.9);
    border-radius: 999px;
    background: #fffaf2;
    color: #6b5f4e;
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .priority-tag-list + * {
    margin: 0;
  }

  .latest-reading-section {
    border-top: 1px solid rgba(231, 229, 228, 0.82);
    background: #fffdf8;
    padding: clamp(34px, 5vw, 52px) 0 clamp(48px, 6vw, 68px);
  }

  .latest-reading-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  .latest-reading-copy h2 {
    margin-top: 6px;
    font-size: clamp(1.85rem, 3vw, 2.55rem);
  }

  .latest-reading-copy p:not(.page-kicker) {
    max-width: 600px;
    margin-top: 12px;
    color: #5f6b7a;
    line-height: 1.62;
  }

  .latest-reading-card {
    display: grid;
    gap: 14px;
    border: 1px solid rgba(214, 200, 181, 0.78);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 22px rgba(63, 47, 31, 0.045);
    color: var(--text);
    padding: clamp(18px, 3vw, 24px);
  }

  .latest-reading-card:hover {
    border-color: rgba(180, 83, 9, 0.34);
    background: #fff;
    color: var(--text);
    text-decoration: none;
  }

  .latest-reading-card div {
    display: grid;
    gap: 4px;
  }

  .latest-reading-card span {
    color: #64748b;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .latest-reading-card strong {
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
  }

  .latest-reading-card p {
    color: #5f6b7a;
    font-size: 0.92rem;
  }

  .latest-reading-card small {
    color: var(--gold-dark);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 720;
  }

  @media (max-width: 1020px) {
    .priority-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-copy {
      max-width: 680px;
    }

    .featured-projects {
      border-top: 1px solid var(--border);
      padding-top: 28px;
      padding-left: 0;
    }

  }

  @media (max-width: 820px) {
    .latest-reading-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 34px 0 38px;
    }

    .hero-copy h1 {
      font-size: clamp(2.65rem, 14vw, 4rem);
    }

    .priority-project-card {
      grid-template-columns: 1fr;
      gap: 12px;
      min-height: 0;
      padding: 12px;
    }

    .priority-project-card img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      grid-row: auto;
    }

    .priority-tag-list {
      gap: 5px;
    }
  }

  @media (max-width: 430px) {
    .hero-section {
      padding: 32px 0 36px;
    }

    .hero-copy .button {
      width: 100%;
    }

  }
</style>
